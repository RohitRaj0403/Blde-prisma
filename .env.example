# Database (set this in Render/Railway dashboard)
DATABASE_URL="postgresql://user:password@host:5432/blde_prism?schema=public"

# NextAuth (generate secret with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# For production on Render/Railway, NEXTAUTH_URL is set automatically
# via the RAILWAY_PUBLIC_DOMAIN or Render service URL env var
